# OpenAmadeus Server Environment Configuration
# Copy this file to `server/.env` and fill in your local values.
# All fields are optional when keys or URLs are configured from the UI Settings modal.

# ==============================================================================
# 1. LLM Providers (Resolution priority: request apiKey -> GROQ -> OPENROUTER -> GEMINI)
# ==============================================================================
GROQ_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=

# ==============================================================================
# 2. FastAPI Gateway & Persistence
# ==============================================================================
AMADEUS_HOST=127.0.0.1
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://tauri.localhost,tauri://localhost
# Optional custom runtime directory for SQLite (amadeus.db) and ChromaDB (memory_db).
# Defaults to `./data` when unset.
# AMADEUS_DATA_DIR=

# ==============================================================================
# 3. Kurisu Qwen3-TTS Neural Voice Worker (Remote Colab or Local GPU)
# ==============================================================================
# Execution mode: remote | local | auto
QWEN_MODE=remote
# Public HTTPS URL printed by notebooks/Amadeus_Qwen3_TTS_Colab.ipynb
QWEN_REMOTE_URL=
QWEN_WORKER_PORT=8005
# Runtime backend: auto | faster | stock
QWEN_BACKEND=auto
QWEN_MODEL_ID=lucca3447/Makise_Kurisu_Qwen3_TTS_PTBR_added
# Keep false for SFT checkpoints not trained with CustomVoice instruct prompts
QWEN_USE_EMOTION_INSTRUCT=false
# Optional overrides for local Qwen3 worker
QWEN_LORA_PATH=
QWEN_PYTHON=

# ==============================================================================
# 4. Cognitive Core & Sleep-Time Compute (v0.4.0)
# ==============================================================================
# Background LLM provider: auto (Gemini -> Groq failover) | gemini | groq | off
AMADEUS_BG_PROVIDER=auto
# Optional explicit model overrides for background consolidation
AMADEUS_BG_GEMINI_MODEL=
AMADEUS_BG_GROQ_MODEL=
# Idle threshold (seconds) before unconsolidated sessions trigger sleep-time compute
AMADEUS_IDLE_CONSOLIDATE_SEC=300

# ==============================================================================
# 5. MCP Client & Agent Tool Execution (v0.4.0)
# ==============================================================================
AMADEUS_MCP_ENABLED=true
# Optional path to mcp_servers.json (defaults to ./mcp_servers.json when present)
# AMADEUS_MCP_CONFIG=

# ==============================================================================
# 6. Optional Pluggable Temporal Memory Graph (v0.4.0)
# ==============================================================================
# Default is 'sqlite' (0-infra local bitemporal SQLite + FTS5 Hybrid RRF).
# Set to 'graphiti' to also query an external Graphiti/FalkorDB HTTP bridge with a hard voice-path timeout.
# AMADEUS_GRAPH_BACKEND=sqlite
# AMADEUS_GRAPH_URL=http://127.0.0.1:8088
# AMADEUS_GRAPH_TIMEOUT_SEC=0.35
